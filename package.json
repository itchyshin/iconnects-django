{
  "name": "iconnects-django",
  "version": "0.1.0",
  "private": true,
  "description": "Tailwind + DaisyUI asset pipeline for the i-connects Django MVP.",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.14",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.14"
  }
}